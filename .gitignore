# ===== Unity 生成物 / 缓存(不入库) =====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta 冲突的备份
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# 自动生成的工程/解决方案文件
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 崩溃与临时
sysinfo.txt
*.stackdump
crashlog*.txt

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# Office 打开文件时的临时锁文件
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# 注意:ProjectSettings/ 必须入库!ProjectVersion.txt 保证大家 Unity 版本一致

# 临时日志
unity_import.log
*.log

# ===== tools/ 立绘导出管线的调试中间产物(可从 PSD 重新生成,不入库) =====
tools/layer_probe/
tools/layer_probe2/
tools/psd_preview/
tools/_char_backup/

# 骨骼诊断临时图(本地产物,不提交)
tools/hand_check/

# ===== 动作捕捉管线(tools/pose)=====
# MediaPipe 模型 44MB,脚本里有下载地址,不入库
tools/pose/models/
# 中间产物:骨架/姿态/预览。clip_*.json 是要给 Unity 的成品,保留。
tools/pose/out/pose_*.json
tools/pose/out/skeleton_*.json
tools/pose/out/preview_*.mp4
tools/pose/out/_*
tools/_skeletons.json

# ===== AI 视频动画管线(tools/ai_video)=====
# 只入库 *.py 流水线脚本和 _diag 诊断脚本。
# raw/ = AI 视频抠出的源帧(~477MB,无法从脚本再生,尤其 young_walk_v5 是待接的新对称源),
#        保留在本地但不推 GitHub;其余 final/alpha/plates/_backup 均为可重跑的中间产物(已物理删除)。
tools/ai_video/raw/
tools/ai_video/final/
tools/ai_video/alpha/
tools/ai_video/plates/
tools/ai_video/_backup_*/
tools/ai_video/_diag/*.png
tools/ai_video/_*.png

# ===== 千眼回廊 黄铜眼(眼睑开合序列帧) =====
# AI 视频抽出的 71 张原始帧(14MB):素材源,保留在本地;成品 eye_lid_XX.png 已在
# Assets/_Project/Resources/Scenes/ChaseCorridor/EyeLid/ 里入库,可由
# tools/eye_lid_frames.py + 原始 zip 重新生成。
tools/_ai_eye_lid_frames/

# Unity 动画调试备份
*.bak.anim

# WorkBuddy 工作区数据(本地记忆,不入库)
.workbuddy/

# 逐帧立绘归一化的原始帧备份(31MB;原图在 git 历史里,这里只是本地安全网)
tools/_ai_frames_backup/

# 行走帧横向比例校正前的备份(纵向已归一化、横向未校正的中间态)
tools/_walk_aspect_backup/
